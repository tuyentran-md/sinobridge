# Set only the services you explicitly authorize to receive document text.
# Remote APIs are never called without --allow-external. Ollama (local) needs no key.
DEEPSEEK_API_KEY=
DASHSCOPE_API_KEY=      # Qwen (Alibaba Cloud Model Studio, OpenAI-compatible mode)
OPENAI_API_KEY=
GEMINI_API_KEY=
OPENROUTER_API_KEY=
HANVIET_API_KEY=        # any other OpenAI-compatible server (--provider openai-compatible --base-url ...)
# Optional OpenAlex API key (check OpenAlex's current access tiers).
OPENALEX_API_KEY=
